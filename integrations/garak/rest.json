{
  "rest": {
    "RestGenerator": {
      "name": "northwind",
      "uri": "http://127.0.0.1:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer lab-alice-token"
      },
      "req_template_json_object": {
        "message": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "response"
    }
  }
}
